generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A session is just a 6-letter rendezvous code.
// The server NEVER sees plaintext: only opaque ciphertext blobs.
model Session {
  id        String          @id @default(cuid())
  code      String          @unique // 6 uppercase letters — the share code
  createdAt DateTime        @default(now())
  deletedAt DateTime? // set when the session is destroyed for everyone

  participants Participant[]
  messages     EncryptedMessage[]
  keyEnvelopes KeyEnvelope[]

  @@index([createdAt])
}

// A participant = an ephemeral browser device.
// Identity = fingerprint of its public key. No accounts, no passwords.
model Participant {
  id          String   @id @default(cuid())
  sessionId   String
  fingerprint String // SHA-256 (truncated) of the participant's public key
  publicKey   String // base64 SPKI public key — the ONLY public material stored
  joinedAt    DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, fingerprint])
  @@index([sessionId])
}

// Persisted message = ciphertext + IV + sender fingerprint + counter.
// The server cannot read any of it. Decryption happens only in the browser
// that holds the session key in RAM.
model EncryptedMessage {
  id          String   @id @default(cuid())
  sessionId   String
  senderFp    String // fingerprint of sender's identity key
  counter     Int // ratchet counter -> unique per-message key
  iv          String // base64 96-bit AES-GCM IV
  ciphertext  String // base64 AES-256-GCM ciphertext of the payload
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// Server-side cache for the Gemini-generated South Africa safety map intel.
// This is PUBLIC curated data (area-level, community-safety oriented) — never
// user content, never key material. Cached so the free-tier API is hit at most
// once per refresh window.
model MapCache {
  id        String   @id // e.g. "sa-gang-hotspots"
  payload   String // JSON-serialized hotspot dataset
  source    String // "gemini" | "fallback"
  updatedAt DateTime @default(now())
}

// WANTED board entry. ZERO-KNOWLEDGE: the server only ever holds AES-256-GCM
// ciphertext produced in the browser with a key derived from the gate
// passcode (never transmitted). Title, description, alias, threat, status,
// bounty and author identity all live inside the encrypted payload; the
// uploaded image is a separately encrypted blob. Entries self-destruct 24h
// after creation (enforced on every read + write).
model WantedPost {
  id            String   @id // client-minted UUID
  iv            String // base64 AES-GCM IV for the metadata payload
  ciphertext    String // base64 encrypted JSON payload (title/desc/etc.)
  imgIv         String? // base64 AES-GCM IV for the image blob
  imgCiphertext String? // base64 encrypted JPEG bytes
  creatorFp     String // sender fingerprint (public material — deletion rights)
  createdAt     DateTime @default(now())
  expiresAt     DateTime // createdAt + 24h

  @@index([createdAt])
}

// ALL-TIME MEMBER LEDGER — the "total members ever" counter.
// Zero-knowledge: the client hashes its persistent device id + callsign with
// SHA-256 (salted) and only the digest is ever transmitted. The server can
// count unique digests but can never reverse them into a nickname or a
// device. Rows are NEVER deleted — this is the permanent roll of honour.
model MemberLedger {
  id         String   @id // equals memberHash (already a salted digest)
  memberHash String   @unique // SHA-256(salt|deviceId|nickname) — computed client-side
  firstSeen  DateTime @default(now()) // first time this member ever entered
  lastSeen   DateTime @default(now()) // latest re-assertion
  visits     Int      @default(1) // how many times they came back

  @@index([firstSeen])
}

// Outbound session-key distribution: the session key wrapped (encrypted)
// per-recipient with an ephemeral ECDH exchange. Server stores the blob,
// but without the recipient's private key (which never leaves the browser)
// it is mathematically unusable.
model KeyEnvelope {
  id        String   @id @default(cuid())
  sessionId String
  forFp     String // recipient fingerprint
  epk       String // base64 ephemeral public key used for the wrap
  iv        String // base64 AES-GCM IV for the wrap
  payload   String // base64 wrapped session key ciphertext
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, forFp])
}

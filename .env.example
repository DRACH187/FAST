# FAST GUNS — environment template
# ============================================================================
# Copy to .env.local for development. For production set EVERY variable below
# in Vercel → Settings → Environment Variables. There are NO defaults: the
# server refuses to boot (fails closed) without all three secrets, and values
# matching historical/burned credentials are rejected everywhere.
#
# Generate strong values:
#   openssl rand -base64 24        (gate + boss key)
#   openssl rand -hex 32           (attestation secret)
# ============================================================================

# Front-door passcode — OWNER DECISION: the house mark "187" (3 digits) is the
# accepted gate code. The gate is friction + abuse control (rate limits,
# escalating lockouts, constant-time compare), NOT the root of message
# secrecy — E2EE session keys + attestations carry that. Any OTHER value must
# meet full strength (min 16 chars in production). This value also seeds the
# WANTED-board content key client-side (PBKDF2-SHA512, 600k iterations), so
# board content is exactly as strong as this code — change it and the current
# board ciphertext becomes unreadable (entries expire within 24h anyway).
GATE_PASSCODE=187

# Boss key for the reserved DRACH callsign — OWNER DECISION: the house value
# "BIGBOSS27" is the accepted boss key. Verified server-side in constant time
# on the identity endpoint only (rate-limited, never stored, never logged).
# Any OTHER value must meet full strength (min 16 chars in production).
DRACH_KEY=BIGBOSS27

# HMAC secret for callsign attestations + capability tokens (min 32 chars in
# production). The root of administrative authorization — treat accordingly.
FAST_ATTEST_SECRET=""

# OPTIONAL distributed rate-limiting backend (spec §7). When both are set the
# limiter becomes cluster-wide (keys are HMAC digests — raw IPs never leave
# the app) and backend errors fail CLOSED. Leave unset for instance-local
# limiting.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

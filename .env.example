# FAST GUNS — environment template
# Copy to .env.local (dev) or set in Vercel → Settings → Environment Variables.

# SQLite for Prisma: map-intel cache + the all-time member ledger.
# On Vercel this stays UNSET unless you attach a hosted DB — the ledger and
# intel cache then fail soft (features degrade gracefully, chat is unaffected).
DATABASE_URL="file:./db/custom.db"

# Shared gate passcode (default "187" if unset)
GATE_PASSCODE="187"

# Boss key for the reserved DRACH callsign (default "BIGBOSS27" if unset).
# SET A REAL SECRET IN PRODUCTION.
DRACH_KEY="BIGBOSS27"

# HMAC secret for nickname attestation tokens (has a dev default).
# SET A REAL SECRET IN PRODUCTION.
FAST_ATTEST_SECRET="change-me-187"

# Gemini (map intel) — free tier only, flash-class models only
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# FAST GUNS — environment template
# Copy to .env.local (dev) or set in Vercel → Settings → Environment Variables.


# Shared gate passcode (default "187" if unset)
GATE_PASSCODE="187"

# Boss key for the reserved DRACH callsign.
# SET A REAL SECRET IN PRODUCTION.
DRACH_KEY=""

# HMAC secret for nickname attestation tokens (has a dev default).
# SET A REAL SECRET IN PRODUCTION.
FAST_ATTEST_SECRET="change-me-187"
